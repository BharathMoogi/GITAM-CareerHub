# ─────────────────────────────────────────────────────────────────────────────
# GITAM CareerHub — Production Environment Configuration
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME=GITAM CareerHub API
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
VERSION=1.0.0

# ── Database (PostgreSQL 16) ──────────────────────────────────────────────────
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=careerhub_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=gitam_careerhub

# Connection Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL=300
CACHE_LONG_TTL=3600

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_MODULE_64_CHARS_MINIMUM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20
FEATURE_RATE_LIMITING=true

# ── CORS ──────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["https://careerhub.gitam.edu","https://www.careerhub.gitam.edu"]

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_AI_MENTOR=true
FEATURE_GAMIFICATION=true
FEATURE_RESUME_AI=true
FEATURE_NOTIFICATIONS=true
FEATURE_ANALYTICS=true

# ── AI Provider (set one to enable AI Mentor live responses) ──────────────────
# LLM_PROVIDER=mock           # Default — no API key needed
# LLM_PROVIDER=openai         # Requires OPENAI_API_KEY
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=gemini         # Requires GEMINI_API_KEY
# GEMINI_API_KEY=AIza...
# LLM_PROVIDER=claude         # Requires ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=groq           # Requires GROQ_API_KEY
# GROQ_API_KEY=gsk_...

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@gitam.careerhub.edu
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
EMAIL_FROM=noreply@gitam.careerhub.edu

# ── Monitoring ────────────────────────────────────────────────────────────────
ENABLE_METRICS=true
# SENTRY_DSN=https://xxxxx@sentry.io/xxxx
# OTEL_ENDPOINT=http://otel-collector:4317

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
